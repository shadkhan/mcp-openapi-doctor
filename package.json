{
  "name": "mcp-openapi-doctor",
  "version": "0.1.0",
  "description": "Turn OpenAPI and Swagger specs into validated, curated, safe MCP tools.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-openapi-doctor": "./dist/cli/index.js",
    "openapi-doctor": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit --pretty false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli/index.js"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "commander": "^14.0.0",
    "yaml": "^2.8.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
